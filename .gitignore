evaluation/results/*.csv
!evaluation/results/baseline_*.csv
evaluation/reports/
evaluation/scoreboard.csv

# -- 3D Replay & Derived Tactical Visualizations (Contains raw tracking coordinates) -----------
src/match_payload.js
match_payload.js
barca_3d_interactive_replay.html
src/barca_3d_interactive_replay.html
artifacts/
scratch/

